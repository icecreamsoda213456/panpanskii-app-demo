<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget showing the partner's latest hand-drawn note. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/widget_note_background">

    <!-- Green spinner shown while the PNG downloads over WiFi/data. -->
    <ProgressBar
        android:id="@+id/widget_loader"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="#4CAF50"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_note_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_note_image_description"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_note_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_note_empty"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:maxLines="10"
        android:ellipsize="end"
        android:visibility="visible" />

    <TextView
        android:id="@+id/widget_note_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_note_empty_author"
        android:textColor="#E8DDF5"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_note_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#B9AECB"
        android:textSize="11sp" />
</LinearLayout>
