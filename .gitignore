# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing secrets. Keep the permanent keystore and passwords private.
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# Node dependencies are restored from package-lock.json.
**/node_modules/

# Supabase CLI machine-specific linked-project and cache files.
/supabase/.temp/

# Local environment and private credential files.
.env
.env.*
!.env.example
*.pem
*.p12
